<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
          Android Auto向け「雨雲レーダー」のカー画面(androidx.car.app / Android for Cars App Library)。
          既存のMainActivity(WebView)とは独立に、車の画面はこのCarAppServiceがネイティブ(Kotlin)で描画する
          (車のディスプレイはAndroid Auto側のホストプロセスが管理しており、電話機のWebViewをそのまま
          映すことはできないため)。
          カテゴリはWEATHER(気象アプリ向けに正式に用意されているカテゴリ。POI/Weatherアプリでも
          Surfaceへの地図描画がandroidx.car.app 1.7以降で許可されている)。
          Google Playには提出せず、自分の端末に直接インストールして使う想定(このアプリ自体が元々
          個人利用が前提のため、Android Auto側の「開発者向け設定 > 不明な発信元からのアプリを許可」
          を有効にして使う)。
        -->
        <service
            android:name=".car.RainRadarCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.WEATHER" />
            </intent-filter>
        </service>
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android Auto の雨雲レーダー画面: 現在地を中心に表示するために使用 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android Auto (Car App Library): 地図(Surface)を描画するテンプレートの利用に必要 -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
</manifest>
